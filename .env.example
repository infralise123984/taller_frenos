# ---------------------------------------------------------------------------
# Plantilla de configuración. Copiar a .env y completar.
# El archivo .env NUNCA se versiona.
# ---------------------------------------------------------------------------

# --- Núcleo Django ---------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-insecure-key-do-not-use-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_TIME_ZONE=America/Santiago
DJANGO_LOG_LEVEL=INFO

# Orígenes confiables para CSRF (necesario para probar desde la red local,
# por ejemplo http://192.168.1.50:8000).
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Base de datos ---------------------------------------------------------
# Vacío => SQLite en desarrollo. En producción es obligatoria:
# DATABASE_URL=postgres://usuario:clave@localhost:5432/frenos
DATABASE_URL=
# Segundos que se reutiliza una conexión antes de cerrarla.
DB_CONN_MAX_AGE=600

# --- Caché (rate limiting) -------------------------------------------------
# Vacío => LocMemCache, que sirve solo en desarrollo: no se comparte entre
# workers. En producción se exige un backend compartido. Opciones:
#   dbcache://frenos_cache  -> tabla en la misma base de datos (build.sh la crea)
#   redis://localhost:6379/1
CACHE_URL=

# --- Proveedor de OTP ------------------------------------------------------
# local    => Django genera, hashea y envía el código (desarrollo/pruebas).
# supabase => Supabase Auth envía y valida el código; Django emite la sesión.
OTP_PROVIDER=local
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=10

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_TIMEOUT_SECONDS=10
# False = el correo debe existir ya en Supabase (denegación por defecto).
SUPABASE_OTP_CREATE_USER=False

# --- Bloqueo por intentos fallidos de contraseña ---------------------------
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
SESSION_COOKIE_AGE=43200

# --- Correo ----------------------------------------------------------------
# En desarrollo el código OTP se imprime en la consola del servidor.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Taller de Frenos <no-reply@localhost>
